# Скопируйте в .env рядом с docker-compose.yml и заполните. Файл .env не должен попасть в git.

# Обязательно: токен доступа ZenMoney
API_TOKEN=

# Версия образа. Обновление сервиса: новое значение и docker compose up -d
IMAGE_TAG=1.0.1

# Запрос к API. URL менять обычно не нужно
API_URL=https://api.zenmoney.ru/v8/diff/
API_TIMEOUT=120
API_RETRY_COUNT=3
API_RETRY_DELAY=30

RETENTION_COUNT=30
# Предел размера одного ответа, байт (2 ГиБ)
MAX_BACKUP_BYTES=2147483648

# Расписание
TZ=Asia/Tbilisi
BACKUP_HOUR=3
BACKUP_MINUTE=0
# Сделать копию при старте, если плановый запуск был пропущен
CATCH_UP_MISSED=true

LOG_LEVEL=INFO
